# Runtime connection: Supabase *transaction* pooler (port 6543).
# Shape: postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Used by src/client.ts (web app, whatsapp-worker, seed scripts).
DATABASE_URL=

# drizzle-kit only: Supabase *session* pooler (port 5432), same host/user/db.
# Used by drizzle-dev.config.ts / drizzle-prod.config.ts (generate/migrate/push/studio).
DIRECT_URL=
