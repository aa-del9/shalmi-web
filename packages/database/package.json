{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate:dev": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "db:generate:prod": "drizzle-kit generate --config=drizzle-prod.config.ts",
    "db:migrate:dev": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:push:dev": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:push:prod": "drizzle-kit push --config=drizzle-prod.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed-products": "tsx src/seed-products.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8",
    "@repo/utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "better-auth": "^1.4.12",
    "tsx": "^4.19.2"
  }
}
