# whatsapp-worker — local dev env
# Copy to .env and fill in. Never commit .env.

# ---- runtime ----
PORT=3000
NODE_ENV=development

# ---- database (shared with apps/web) ----
# Worker reads vendor / product / order data directly from Postgres.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---- queue (BullMQ) ----
# Redis URL for inbound + outbound BullMQ queues. On Railway, this is
# usually `redis://default:<pass>@<host>:<port>` from the Redis plugin.
REDIS_URL=redis://localhost:6379

# ---- WhatsApp BSP (waapi.app) ----
# Bearer token from waapi.app → User API Tokens.
WAAPI_API_TOKEN=
# Numeric instance id of the paired WhatsApp account.
WAAPI_INSTANCE_ID=
# Optional override for the API base. Defaults to https://waapi.app.
WAAPI_BASE_URL=https://waapi.app
# Random string we choose. waapi has no HMAC; the secret lives in the
# webhook URL path: /webhook/whatsapp/<token>. Generate with:
#   openssl rand -hex 32
WAAPI_WEBHOOK_TOKEN=

# ---- setup-webhook script (used once per environment) ----
# Public base URL of the deployed worker (no trailing slash). Used by
# `pnpm --filter whatsapp-worker setup-webhook` to register the
# webhook URL with waapi.
WORKER_PUBLIC_URL=https://your-railway-app.up.railway.app
# Optional: override the events the instance subscribes to. Defaults
# to message,ready,qr,disconnected,authenticated.
WAAPI_WEBHOOK_EVENTS=message,ready,qr,disconnected,authenticated

# ---- internal trigger (apps/web → /internal/send-message) ----
# Required header `x-internal-api-key` must equal this value to enqueue
# an outbound message from another internal service.
INTERNAL_API_KEY=

# ---- LLM (Phase 6 — not used in Phase 5) ----
# Google Gemini API key — drives the vendor conversation.
GEMINI_API_KEY=

# ---- Supabase storage (for any media we receive / send) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
