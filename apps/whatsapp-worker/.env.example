# whatsapp-worker — local dev env
# Copy to .env and fill in. Never commit .env.

# ---- runtime ----
PORT=3000
NODE_ENV=development

# ---- database (shared with apps/web) ----
# Worker reads vendor / product / order data directly from Postgres.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---- WhatsApp Cloud API (Meta) ----
# Token Meta calls into the webhook verify GET with — we echo the
# challenge back when this matches.
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify the X-Hub-Signature-256 header on inbound
# POSTs. Required in production.
WHATSAPP_APP_SECRET=
# Phone number id of the WhatsApp Business number we send from.
WHATSAPP_PHONE_NUMBER_ID=
# Business account id (used for media uploads / template management).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Long-lived system-user access token for the WhatsApp Business app.
WHATSAPP_ACCESS_TOKEN=

# ---- LLM ----
# Google Gemini API key — drives the vendor conversation.
GEMINI_API_KEY=

# ---- Supabase storage (for any media we receive / send) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
